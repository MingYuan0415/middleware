menu "Chore service resources"

config CHORE_SERVICE_TASK_STACK_SIZE
    int "Chore worker stack size"
    range 2048 16384
    default 4096

config CHORE_SERVICE_JOB_CAPACITY
    int "Chore job capacity"
    range 1 16
    default 8
    help
        Fixed pool slot count. Bounded by the FreeRTOS event-group bits
        used for per-slot cancellation acknowledgement.

endmenu
