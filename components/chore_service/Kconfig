menu "Chore service resources"

config CHORE_SERVICE_TASK_STACK_SIZE
    int "Chore worker stack size"
    range 4096 16384
    default 4096
    help
        Worker stack size. The -Wframe-larger-than=2048 compile guard
        bounds single frames but not total usage, so the minimum matches
        the product default; reduce only after a real stack-watermark
        measurement.

config CHORE_SERVICE_JOB_CAPACITY
    int "Chore job capacity"
    range 1 16
    default 8
    help
        Fixed pool slot count. Bounded by the FreeRTOS event-group bits
        used for per-slot cancellation acknowledgement.

endmenu
