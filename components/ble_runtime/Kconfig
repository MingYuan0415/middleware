menu "BLE Runtime"

config BLE_RUNTIME_ADV_FAST_INTERVAL_MS
    int "Fast advertising interval in milliseconds"
    range 20 10240
    default 100
    help
        Connectable advertising interval used during the fast window. This is
        runtime policy, calibrated on hardware; it is not part of the wire
        contract.

config BLE_RUNTIME_ADV_SLOW_INTERVAL_MS
    int "Slow advertising interval in milliseconds"
    range 20 10240
    default 700
    help
        Low-power connectable advertising interval used after the fast window.
        Runtime policy, calibrated on hardware.

config BLE_RUNTIME_ADV_FAST_WINDOW_MS
    int "Fast advertising window in milliseconds"
    range 1000 600000
    default 30000
    help
        Duration of the fast advertising window before falling back to slow
        advertising. Runtime policy, calibrated on hardware.

config BLE_RUNTIME_TX_QUEUE_DEPTH
    int "TX scheduler queue depth"
    range 2 32
    default 8
    help
        Bounded number of pending frames the TX scheduler holds per
        connection. Full queues report ESP_ERR_NO_MEM so callers back off.
        The service submits one whole response at a time: at the mandatory
        MTU of 23 a capabilities response needs about 6 frames, so depths
        below 6 are not guaranteed to deliver MTU-23 responses.

config BLE_RUNTIME_TX_FRAME_BYTES
    int "TX scheduler max frame payload"
    range 20 512
    default 495
    help
        Maximum payload of one notified or indicated frame. 495 bytes fits
        one ATT PDU at the preferred MTU of 498.

endmenu
