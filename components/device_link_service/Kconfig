menu "Device Link Service"

config DEVICE_LINK_SERVICE_TASK_STACK
    int "Device Link service worker stack size in bytes"
    range 2048 16384
    default 6144
    help
        Worker task stack for the binding window and status machinery.

config DEVICE_LINK_SERVICE_QUEUE_DEPTH
    int "Device Link service command queue depth"
    range 4 32
    default 8
    help
        Bounded command queue depth for window, publish, and teardown
        commands. Commands are rare (window open/close, connect events),
        so a shallow queue is sufficient.

config DEVICE_LINK_SERVICE_WIFI_ADVERTISED
    bool "Advertise the Wi-Fi domain in the Device Link manifest"
    default n
    help
        Explicit capability gate for publishing the Wi-Fi domain: the
        domain descriptor is frozen into the startup router only when
        this option is enabled AND the connectivity manager adapter is
        ready. Keep disabled until the Wi-Fi domain end-to-end matrix
        (write, reboot, storage failure, recovery) passes on hardware;
        then flip it and the registry advertised flag together.

endmenu
