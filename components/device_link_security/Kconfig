menu "Device Link Security"

config DEVICE_LINK_SECURITY_STORAGE_FAULT_TEST
    bool "Storage fault injection for the hardware matrix (debug only)"
    default n
    help
        Debug-only instrumentation for on-device matrix item 6: injects a
        storage failure or corruption on the durable authorization record
        and revoke-journal writes so the fail-closed paths can be
        exercised on hardware. Production builds must keep this disabled.

config DEVICE_LINK_SECURITY_STORAGE_FAULT_WRITE_N
    int "Fail the Nth durable write (0 = every write)"
    range 0 64
    default 1
    depends on DEVICE_LINK_SECURITY_STORAGE_FAULT_TEST
    help
        The Nth committed-record or revoke-journal write returns
        ESP_ERR_NO_MEM; 0 fails every write. Set above the expected write
        count when pairing with the corrupt-write mode.

config DEVICE_LINK_SECURITY_STORAGE_CORRUPT_WRITE
    bool "Corrupt durable record writes instead of failing them"
    default n
    depends on DEVICE_LINK_SECURITY_STORAGE_FAULT_TEST
    help
        Lands a structurally corrupted blob (flipped magic) instead of
        failing the write, so the fail-closed invalid-record branch can
        be exercised on device.

endmenu
